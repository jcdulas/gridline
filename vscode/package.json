{
  "name": "gridsntabs",
  "displayName": "Grids&Tabs",
  "description": "An offline spreadsheet editor for local workbooks and delimited text.",
  "version": "0.1.11",
  "publisher": "jcdulas",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcdulas/gridline.git"
  },
  "bugs": {
    "url": "https://github.com/jcdulas/gridline/issues"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Grids&Tabs runs in local, trusted workspaces."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "gridsntabs.configureFileAssociations",
        "category": "Grids&Tabs",
        "title": "Choose Which Files Open in Grids&Tabs"
      }
    ],
    "configuration": {
      "title": "Grids&Tabs",
      "properties": {
        "gridsntabs.openXlsx": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Open XLSX workbooks (.xlsx) in Grids&Tabs by default.",
          "order": 1
        },
        "gridsntabs.openCsv": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Open comma-separated files (.csv) in Grids&Tabs by default.",
          "order": 2
        },
        "gridsntabs.openTsv": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Open tab-separated files (.tsv) in Grids&Tabs by default.",
          "order": 3
        },
        "gridsntabs.openTxt": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Open text files (.txt) in Grids&Tabs when they contain tabular data. Other text opens in the standard text editor.",
          "order": 4
        }
      }
    },
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.xlsx": "gridsntabs.workbook",
        "*.gridsntabs": "gridsntabs.workbook"
      }
    },
    "customEditors": [
      {
        "viewType": "gridsntabs.workbook",
        "displayName": "Grids&Tabs",
        "selector": [
          { "filenamePattern": "*.xlsx" },
          { "filenamePattern": "*.gridsntabs" },
          { "filenamePattern": "*.csv" },
          { "filenamePattern": "*.tsv" },
          { "filenamePattern": "*.txt" },
          { "filenamePattern": "*.text" },
          { "filenamePattern": "*.prn" },
          { "filenamePattern": "*.dat" },
          { "filenamePattern": "*.log" }
        ],
        "priority": "option"
      }
    ]
  }
}
